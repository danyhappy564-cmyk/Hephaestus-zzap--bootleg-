<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <!-- the client plugin's pure logic (no BepInEx/Unity) is compiled in directly -->
    <Compile Include="..\..\HephaestusClient\src\ClientLogic.cs" Link="ClientLogic.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Hephaestus\Hephaestus.csproj" />
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.6" />
  </ItemGroup>
</Project>
