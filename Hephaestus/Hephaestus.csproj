<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Hephaestus</AssemblyName>
    <RootNamespace>Hephaestus</RootNamespace>
    <Version>1.2.0</Version>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- SPT 4.1.6 server runtime already ships these; compile against them only -->
    <PackageReference Include="SPTushonka.Server.Core" Version="4.1.6" ExcludeAssets="runtime" />
    <PackageReference Include="SPTushonka.Reflection" Version="4.1.6" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hephaestus.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="db\base.json" CopyToOutputDirectory="PreserveNewest" Link="db\base.json" />
    <None Include="config\config.json" CopyToOutputDirectory="PreserveNewest" Link="config\config.json" />
    <None Include="res\img.jpg" CopyToOutputDirectory="PreserveNewest" Link="res\img.jpg" />
  </ItemGroup>

</Project>
